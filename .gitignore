*-revenuecat-*.json
firebase-debug.log
firestore-debug.log
AuthKey_*.p8
google-services.json
GoogleService-Info.plist
google_credentials*.json
*.mobileprovision
ExportOptions.plist
.netrc
.npmrc
.pypirc
.env-backup/
.supabase/
supabase/.env
supabase/functions/.env
supabase/secrets.toml
supabase/.temp/

